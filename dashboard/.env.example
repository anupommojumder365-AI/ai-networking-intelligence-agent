# ---------------------------------------------------------------
# NIS Command Center - environment variables
# Copy to .env.local for local dev; add the same names in
# Vercel -> Project -> Settings -> Environment Variables.
# Every value is read SERVER-SIDE only. None use the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------

# Supabase project (the same one the n8n workflows use)
SUPABASE_URL=https://yhssfzpsujhtngjrkauv.supabase.co
# Supabase -> Project Settings -> API -> service_role (secret) key.
# Required because every table is RLS deny-all. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard login (single owner)
DASHBOARD_PASSWORD=
# Random string, 32+ chars, used to sign the session cookie: openssl rand -hex 32
SESSION_SECRET=

# n8n gateway (workflow "NIS 05 - Dashboard Gateway")
N8N_GATEWAY_URL=https://mklo.app.n8n.cloud/webhook/nis-dashboard-gateway
# Must equal the gateway_secret row in the n8n data table nis_dashboard_config
N8N_GATEWAY_SECRET=

# Your Telegram user ID (same ID as in the n8n allowlist). Stored on activity rows
# you confirm from the dashboard, exactly like the Telegram buttons do.
OWNER_TELEGRAM_ID=
